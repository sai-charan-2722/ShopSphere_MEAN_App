{
  "name": "shopsphere-backend",
  "version": "1.0.0",
  "description": "ShopSphere backend — Express + TypeScript + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
